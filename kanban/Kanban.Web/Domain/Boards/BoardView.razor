@using Kanban.Web.Common.Components
@using Kanban.Web.Domain.Swimlanes.Fragments
@using Kanban.Web.Entities

<section id="board-@Board.PublicId" aria-labelledby="board-@Board.Id-title">
    <h1 id="board-@Board.PublicId-title">@Board.Name</h1>
    <div class="lanes" id="board-@Board.PublicId-lanes">
        @foreach (var lane in Board.Swimlanes)
        {
            <SwimlaneView Swimlane="lane" />
        }
        <AddSwimlaneComponent BoardId="@Board.PublicId" />
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required Board Board { get; init; }
}
