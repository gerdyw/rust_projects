@using Kanban.Web.Domain.Swimlanes.Fragments
@using Kanban.Web.Entities

<SwimlaneTaskCount SwimlaneId="@DestSwimlane.PublicId" TaskItemCount="@DestSwimlane.TaskItems.Count" SwapOob="true" />

@foreach (var swimlane in SourceSwimlanes)
{
    <SwimlaneTaskCount SwimlaneId="@swimlane.PublicId" TaskItemCount="@swimlane.TaskItems.Count" SwapOob="true" />
}

@code {
    [Parameter, EditorRequired]
    public required Swimlane DestSwimlane { get; init; }
    [Parameter]
    public IEnumerable<Swimlane> SourceSwimlanes { get; init; } = [];
}
