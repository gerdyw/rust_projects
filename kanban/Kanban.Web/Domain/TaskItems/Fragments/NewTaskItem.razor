@using Microsoft.AspNetCore.Components.Forms

<form hx-post="@SubmitEndpoint" hx-trigger="submit" hx-target="#swimlane-@SwimlaneId-tasks" hx-swap="beforeend">
    <AntiforgeryToken />
    <input name="swimlaneId" type="hidden" value="@SwimlaneId" />
    <label>Name: <input name="name" /></label>
    <label>Description: <input name="description" /></label>
    <button type="submit">Add</button>
</form>

@code {
    [Parameter, EditorRequired]
    public required string SubmitEndpoint { get; init; }
    [Parameter, EditorRequired]
    public required Guid SwimlaneId { get; init; }
}
