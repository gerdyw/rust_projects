@using Microsoft.AspNetCore.Components.Forms
<section id="add-swimlane-section" class="lane" aria-labelledby="add-swimlane-title">
    <header>
        <h2 id="add-swimlane-title">Add Lane</h2>
    </header>
    <form hx-post="@SubmitEndpoint" hx-trigger="submit" hx-target="#add-swimlane-section" hx-swap="outerHTML">
        <AntiforgeryToken />
        <input type="hidden" name="BoardId" value="@BoardId" />
        <label>Title: <input name="Name" </label>
        <label>Close Tasks: <input name="CloseTask" type="checkbox" value="true" /> </label>
        <button type="submit">Add</button>
    </form>
</section>

@code {
    [Parameter, EditorRequired]
    public required string SubmitEndpoint { get; init; }
    [Parameter, EditorRequired]
    public required Guid BoardId { get; set; }
}
