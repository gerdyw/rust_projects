@using Kanban.Web.Domain.TaskItems
@using Kanban.Web.Domain.TaskItems.Fragments
@using Kanban.Web.Entities
<section id="swimlane-@Swimlane.PublicId" class="lane" aria-labelledby="@Swimlane.PublicId-title">
    <header>
        <h2 id="@Swimlane.PublicId-title">@Swimlane.Name</h2>
        <SwimlaneTaskCount SwimlaneId="@Swimlane.PublicId" TaskItemCount="@Swimlane.TaskItems.Count" />
    </header>

    <ul id="swimlane-@Swimlane.PublicId-tasks" role="list">
        @foreach (var task in Swimlane.TaskItems)
        {
            <TaskItemView TaskItem="task" />
        }
        <li id="swimlane-@Swimlane.PublicId-add-task">
            <AddTaskItemComponent SwimlaneId="@Swimlane.PublicId" />
        </li>
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public required Swimlane Swimlane { get; init; }
}
