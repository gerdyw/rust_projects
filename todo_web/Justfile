set dotenv-load := true
set dotenv-path := "local.env"

run:
    cargo run

docker-up:
    docker build -t todo_web .
    docker compose --env-file local.env up -d

docker-down:
    docker compose --env-file local.env down

service-restart:
    docker compose --env-file local.env restart todo_web

service-up:
    docker compose --env-file local.env up -d todo_web

service-down:
    docker compose --env-file local.env down todo_web

rebuild:
    docker compose --env-file local.env build --no-cache
    docker compose --env-file local.env up -d

# Deployment commands
deploy:
    ssh -Y pi@raspberrypi.local 'bash -s' < ./scripts/deploy-service.sh

deploy-image:
    ./scripts/deploy-from-registry.sh

update-repo:
    ssh -Y pi@raspberrypi.local 'bash -s' < ./scripts/update-repo.sh

# Database commands
db-up:
    docker compose --env-file local.env up -d db

db-down:
    docker compose --env-file local.env down db

# Tunnel commands
tunnel-up:
    docker compose --env-file local.env up -d cloudflared

tunnel-down:
    docker compose --env-file local.env down cloudflared

logs:
    docker compose --env-file local.env logs -f

ps:
    docker compose --env-file local.env ps