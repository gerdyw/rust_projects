# Environment variables template
# Copy this file to .env and adjust values as needed: cp .env.example .env

# Database configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=exampledb
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Service configuration
SERVICE_PORT=3000

# API Key Authentication
# Set API_KEY_DISABLED=true to disable authentication (not recommended for production)
# If disabled, API_KEY is not required
API_KEY_DISABLED=false
API_KEY=your-secret-api-key-here

# Logging level
RUST_LOG=project_name=debug,tower_http=debug

# SQLx compile-time verification (for local development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exampledb
