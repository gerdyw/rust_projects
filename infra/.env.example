# Secrets and local overrides only. Non-secret defaults live in .env.defaults and env/*.env

# Database (secret)
DATABASE_PASSWORD=your-secure-password-here
POSTGRES_PASSWORD=your-secure-password-here
DATABASE_URL=postgres://postgres:your-secure-password-here@db:5432/services_db

# Registry (secret)
REGISTRY_SECRET=changeme_registry_secret_here

# Image Stitch service (secret)
IS_API_KEY=changeme_image_stitch_api_key_here
API_KEY=changeme_image_stitch_api_key_here

# Cloudflare (production only)
CLOUDFLARE_TOKEN=changeme_your_tunnel_token_here