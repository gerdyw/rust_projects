# Environment variables for Docker deployment
# Copy this file to .env and adjust values for your deployment

# Service configuration
SERVICE_PORT=3000

# Database configuration
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=image_stitch_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-password-here

# API Key Authentication Mode
# Options: 'full' - require API key for all endpoints (default)
#          'submit_only' - require API key only for /stitch and /jobs POST endpoints
#          'none' - no API key required
API_KEY_MODE=none
API_KEY=your_api_key_here

# Logging level
RUST_LOG=image_stitch=debug,tower_http=debug
