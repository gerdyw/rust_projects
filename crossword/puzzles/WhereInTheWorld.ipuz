    "clues": {
        "Across": [
            {
                "number": 1,
                "clue": "Erstwhile radio show hosted by Tom and Ray Magliozzi"
            },
            {
                "number": 7,
                "clue": "TV, in America, or subway, in the UK"
            },
            {
                "number": 8,
                "clue": "Put on"
            },
            {
                "number": 10,
                "clue": "&quot;I called it!&quot;"
            },
            {
                "number": 11,
                "clue": "Elementary school quintet"
            },
            {
                "number": 13,
                "clue": "&quot;Who Can It Be Now?&quot; singers"
            },
            {
                "number": 16,
                "clue": "Org. which gives out the Larry O'Brien Championship Trophy"
            },
            {
                "number": 18,
                "clue": "Westernmost Mexican state, familiarly"
            },
            {
                "number": 19,
                "clue": "Ayn who said of Native Americans &quot;They had no right to a country merely because they were born here and then acted like savages.&quot;"
            },
            {
                "number": 20,
                "clue": "Team that has probably flamed out of the Women's World Cup by the time you read this"
            },
            {
                "number": 22,
                "clue": "Świątek who won the 2023 French Open"
            },
            {
                "number": 23,
                "clue": "God played by Ray Winstone in <i>Percy Jackson &amp; the Olympians: The Lightning Thief</i>"
            },
            {
                "number": 24,
                "clue": "Prefix with &quot;war&quot; or &quot;hero&quot;"
            },
            {
                "number": 25,
                "clue": "&quot;I __ the Walrus&quot;"
            },
            {
                "number": 26,
                "clue": "Org. that merged with the AFL in 1955"
            },
            {
                "number": 27,
                "clue": "Whirlybird"
